# Nettsidens miljø. Kopier fila til `web/.env` og fyll inn.
# Ingen av verdiene har en reserveverdi i koden: mangler de, stopper
# byggingen. Det er med vilje (punkt 108 i docs/GJENSTÅR.md).
#
# PUBLIC_HEIA_ENV velger datamiljø eksplisitt:
#   production  heiaapp.no, ekte lag og ekte betalinger
#   test        et eget Supabase-prosjekt for prøving
#   local       `supabase start` på egen maskin
#
# Alt utenom `production` — og alt som kjører på en annen vertsadresse enn
# heiaapp.no — får et synlig miljømerke nede til høyre.
PUBLIC_HEIA_ENV=local

# Adressen til Supabase-prosjektet. Ingen skråstrek til slutt.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon-nøkkelen. Offentlig per design — autorisasjonen bor i Postgres
# (RLS + RPC) — men den avgjør hvilket prosjekt nettsiden skriver til.
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
