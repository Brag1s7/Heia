{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "max-age=3600"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ops/:path+",
      "destination": "/ops/"
    },
    {
      "source": "/klubb/:path+",
      "destination": "/klubb/"
    }
  ]
}