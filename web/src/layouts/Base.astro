---
import '../styles/global.css';
import {primaryCta, CONTACT_EMAIL, LEGAL, APP_STORE_ID} from '../config';
import {SUPABASE_URL, SUPABASE_ANON_KEY, AUTH_STORAGE_KEY, ROLES_STORAGE_KEY, AUTH_EVENT} from '../lib/env';

interface Props {
  title: string;
  description?: string;
  /** true = arbeidsflate (konto/ops/klubb …): ingen markedsmeny eller CTA,
   *  men Forsiden/Hjelp og kontomenyen står. */
  minimal?: boolean;
  /** Ingen tredjeparts- eller ekstra-skript på siden (invitasjon o.l.). */
  noindex?: boolean;
}
const {title, description = 'Heia — appen som samler laget og alle rundt det. Treninger, kamper, bilder og øyeblikk, så familien kan følge med og heie.', minimal = false, noindex = false} = Astro.props;
const cta = primaryCta();
const fullTitle = title === 'Heia' ? 'Heia' : `${title} · Heia`;
const legalLine = LEGAL.companyName && LEGAL.orgNumber
  ? `${LEGAL.companyName} · org.nr. ${LEGAL.orgNumber}${LEGAL.address ? ' · ' + LEGAL.address : ''}`
  : null;
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#DFFFF1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:image" content={new URL('/img/og.png', Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    {APP_STORE_ID && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}
  </head>
  <body>
    <div class="ground" aria-hidden="true"></div>

    <header class="site-header" data-minimal={minimal ? '' : undefined}>
      <div class="container">
        <div class="bar">
          <a class="logo" href="/" aria-label="Heia — til forsiden">
            <img class="logo-d" src="/img/logo-green-wordmark.png" alt="Heia" />
            <img class="logo-m" src="/img/logo-deep-wordmark.png" alt="Heia" />
          </a>
          <nav aria-label="Hovedmeny">
            {!minimal ? (
              <>
                <a href="/#slik" class="hide-m">Slik fungerer Heia</a>
                <a href="/stott-laget/">Støtt laget</a>
                <a href="/hjelp/">Hjelp</a>
              </>
            ) : (
              <>
                <a href="/">Forsiden</a>
                <a href="/hjelp/">Hjelp</a>
              </>
            )}
            {/* Uinnlogget: «Logg inn». Innlogget: «Min konto»-menyen med
                innganger etter rettigheter. Skiftet gjøres av skriptet under,
                som leser sesjonen supabase-js har lagret. */}
            <a class="nav-login" href="/konto/" data-auth="out">Logg inn</a>
            <details class="acct" data-auth="in" hidden>
              <summary aria-label="Min konto">
                <span>Min konto</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <div class="acct-menu">
                <div class="acct-who"><b data-acct-name></b><small data-acct-email></small></div>
                <a href="/konto/">Min konto</a>
                <a href="/ops/" data-role="ops" hidden>Heia-admin</a>
                <a href="/klubb/" data-role="manager" hidden>Klubbetalinger</a>
                <button type="button" data-signout>Logg ut</button>
              </div>
            </details>
            {!minimal && (
              <a class="btn btn-primary" href={cta.href}><span class="full">{cta.label}</span><span class="short">Få laget med</span></a>
            )}
            <button class="menu-btn" type="button" aria-label="Meny" aria-expanded="false" aria-controls="mobile-menu" id="menu-btn">
              <svg class="ico-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
              <svg class="ico-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </nav>
          <div class="mobile-menu" id="mobile-menu">
            {!minimal ? (
              <>
                <a href="/#slik">Slik fungerer Heia</a>
                <a href="/#bidra">Sammen får laget til mer</a>
                <a href="/stott-laget/">Støtt laget</a>
                <a href="/#kom-i-gang">Kom i gang</a>
                <a href="/hjelp/">Hjelp</a>
                <a href="/om/">Om Heia</a>
              </>
            ) : (
              <>
                <a href="/">Forsiden</a>
                <a href="/hjelp/">Hjelp</a>
              </>
            )}
            <div class="menu-account" data-auth="in" hidden>
              <div class="menu-who">Innlogget som <b data-acct-name></b></div>
              <a href="/konto/">Min konto</a>
              <a href="/ops/" data-role="ops" hidden>Heia-admin</a>
              <a href="/klubb/" data-role="manager" hidden>Klubbetalinger</a>
              <button type="button" data-signout>Logg ut</button>
            </div>
            <div class="menu-cta">
              <a class="btn btn-ghost" href="/konto/" data-auth="out">Logg inn</a>
              {!minimal && <a class="btn btn-primary" href={cta.href}>{cta.label}</a>}
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Kontomenyen i headeren, uten supabase-js: leser sesjonen supabase-js
         lagrer i localStorage, spør de to rolle-RPC-ene med brukerens token og
         husker svaret per bruker. Øyene sender AUTH_EVENT ved endring. -->
    <script is:inline define:vars={{SUPABASE_URL, SUPABASE_ANON_KEY, AUTH_STORAGE_KEY, ROLES_STORAGE_KEY, AUTH_EVENT}}>
      (function () {
        var header = document.querySelector('.site-header');
        if (!header) return;
        function all(sel, fn) { header.querySelectorAll(sel).forEach(fn); }
        function readSession() {
          try {
            var raw = localStorage.getItem(AUTH_STORAGE_KEY);
            if (!raw) return null;
            var s = JSON.parse(raw);
            return s && s.access_token && s.user && s.user.id ? s : null;
          } catch (e) { return null; }
        }
        function readRoles(uid) {
          try {
            var r = JSON.parse(localStorage.getItem(ROLES_STORAGE_KEY) || 'null');
            return r && r.uid === uid ? r : null;
          } catch (e) { return null; }
        }
        function applyRoles(r) {
          all('[data-role="ops"]', function (el) { el.hidden = !(r && r.ops); });
          all('[data-role="manager"]', function (el) { el.hidden = !(r && r.manager); });
        }
        function rpc(name, token) {
          return fetch(SUPABASE_URL + '/rest/v1/rpc/' + name, {
            method: 'POST',
            headers: {apikey: SUPABASE_ANON_KEY, Authorization: 'Bearer ' + token, 'Content-Type': 'application/json'},
            body: '{}',
          }).then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
          }).then(function (v) { return v === true; });
        }
        var inflight = null;
        function fetchRoles(s) {
          if (inflight) return;
          inflight = Promise.all([rpc('is_ops_admin', s.access_token), rpc('is_payment_manager_anywhere', s.access_token)])
            .then(function (v) {
              var r = {uid: s.user.id, ops: v[0], manager: v[1], at: Date.now()};
              try { localStorage.setItem(ROLES_STORAGE_KEY, JSON.stringify(r)); } catch (e) {}
              var now = readSession();
              if (now && now.user.id === s.user.id) applyRoles(r);
            })
            .catch(function () {})
            .then(function () { inflight = null; });
        }
        function render() {
          var s = readSession();
          all('[data-auth="out"]', function (el) { el.hidden = !!s; });
          all('[data-auth="in"]', function (el) { el.hidden = !s; });
          if (!s) { applyRoles(null); return; }
          var meta = s.user.user_metadata || {};
          var name = meta.display_name || s.user.email || '';
          all('[data-acct-name]', function (el) { el.textContent = name; });
          all('[data-acct-email]', function (el) { el.textContent = s.user.email || ''; });
          applyRoles(readRoles(s.user.id));
          // Utløpt token gir 401 — da står cachen til øya har fornyet sesjonen
          // (den sender AUTH_EVENT, og vi spør på nytt).
          if (!s.expires_at || s.expires_at * 1000 > Date.now() + 5000) fetchRoles(s);
        }
        function signOut() {
          var s = readSession();
          var done = function () {
            try { localStorage.removeItem(AUTH_STORAGE_KEY); localStorage.removeItem(ROLES_STORAGE_KEY); } catch (e) {}
            location.href = '/';
          };
          all('[data-signout]', function (el) { el.disabled = true; });
          var viaIsland = window.__heiaSignOut;
          var p = viaIsland
            ? viaIsland()
            : s
              ? fetch(SUPABASE_URL + '/auth/v1/logout', {method: 'POST', headers: {apikey: SUPABASE_ANON_KEY, Authorization: 'Bearer ' + s.access_token}})
              : Promise.resolve();
          Promise.resolve(p).catch(function () {}).then(done);
        }
        all('[data-signout]', function (el) { el.addEventListener('click', signOut); });
        render();
        window.addEventListener(AUTH_EVENT, render);
        window.addEventListener('storage', function (e) { if (e.key === AUTH_STORAGE_KEY) render(); });

        var acct = header.querySelector('details.acct');
        if (acct) {
          document.addEventListener('click', function (e) { if (acct.open && !acct.contains(e.target)) acct.open = false; });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape') acct.open = false; });
        }
      })();
    </script>

    <main>
      <slot />
    </main>
    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        const set = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          if (open) menu.setAttribute('data-open', ''); else menu.removeAttribute('data-open');
        };
        btn.addEventListener('click', () => set(!menu.hasAttribute('data-open')));
        // Frost på mobilheaderen først når siden er scrollet.
        const header = document.querySelector('.site-header') as HTMLElement | null;
        const onScroll = () => {
          if (!header) return;
          if (window.scrollY > 8) header.setAttribute('data-scrolled', ''); else header.removeAttribute('data-scrolled');
        };
        onScroll();
        window.addEventListener('scroll', onScroll, {passive: true});
        menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A') set(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
      }
    </script>

    <footer class="site-footer">
      <div class="container">
        <div class="top">
          <div>
            <a class="logo" href="/" aria-label="Heia"><img src="/img/logo-green-wordmark.png" alt="Heia" /></a>
            <p>Appen som samler laget og alle rundt det. Følg med, hei på laget og støtt det — også når du ikke er på sidelinja.</p>
            <p class="mt-1"><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
          </div>
          <div>
            <h4>Heia</h4>
            <ul>
              <li><a href="/#slik">Slik fungerer Heia</a></li>
              <li><a href="/stott-laget/">Støtt laget</a></li>
              <li><a href="/#kom-i-gang">Kom i gang med laget</a></li>
              <li><a href="/om/">Om Heia</a></li>
            </ul>
          </div>
          <div>
            <h4>Hjelp og vilkår</h4>
            <ul>
              <li><a href="/hjelp/">Hjelp og spørsmål</a></li>
              <li><a href="/vilkar/">Vilkår for bruk</a></li>
              <li><a href="/personvern/">Personvern</a></li>
              <li><a href="/konto/">Logg inn</a></li>
              <li><a href={`mailto:${CONTACT_EMAIL}`}>Kontakt oss</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <span>© {new Date().getFullYear()} Heia</span>
          {legalLine ? <span>{legalLine}</span> : <span>Selskapsopplysninger (foretaksnavn, organisasjonsnummer og adresse) publiseres her når de er bekreftet.</span>}
        </div>
      </div>
    </footer>
  </body>
</html>
