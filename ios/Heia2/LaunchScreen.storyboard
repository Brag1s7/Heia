<?xml version="1.0" encoding="UTF-8"?>
<!--
  Heia launch screen — stadionflaten i fullskjerm med jubelmerket sentrert.

  Samme flate som WelcomeIntentScreen fikk i designskive 3, så oppstarten og
  appens første skjerm er ett og samme bilde i stedet for et hvitt blink.

  Bakgrunnen er et BILDE, ikke en gradient: storyboards kan ikke tegne
  gradienter. Den strekkes med scaleAspectFill og tåler alle skjermformater
  fordi den er en glatt overgang uten detaljer som kan forvrenges.

  Ingen tekst med vilje — iOS viser allerede «Heia» under ikonet man trykket på.
  Begge bildene genereres av scripts/build-app-icon.py.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchBackground" translatesAutoresizingMaskIntoConstraints="NO" id="bgv-00-001">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="mkv-00-002">
                                <rect key="frame" x="130.5" y="326.5" width="132" height="199"/>
                            </imageView>
                        </subviews>
                        <!-- colors.stadium (#0E211A) — synlig et blunk før bildet dekodes -->
                        <color key="backgroundColor" red="0.054901960784313725" green="0.12941176470588237" blue="0.10196078431372549" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <!-- Bakgrunnen går kant til kant, IKKE til safe area:
                                 en launch screen skal dekke hele skjermen. -->
                            <constraint firstItem="bgv-00-001" firstAttribute="top" secondItem="Ze5-6b-2t3" secondAttribute="top" id="cn1-00-001"/>
                            <constraint firstItem="bgv-00-001" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" id="cn2-00-002"/>
                            <constraint firstAttribute="trailing" secondItem="bgv-00-001" secondAttribute="trailing" id="cn3-00-003"/>
                            <constraint firstAttribute="bottom" secondItem="bgv-00-001" secondAttribute="bottom" id="cn4-00-004"/>
                            <!-- Merket sentreres. Ingen størrelse angitt: @1x-bildet ER
                                 punktstørrelsen (132×199), så intrinsic size holder. -->
                            <constraint firstItem="mkv-00-002" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="cn5-00-005"/>
                            <constraint firstItem="mkv-00-002" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" id="cn6-00-006"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52.173913043478265" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBackground" width="1170" height="2532"/>
        <image name="LaunchMark" width="132" height="199"/>
    </resources>
</document>
